{
  "name": "unleash-action",
  "version": "1.0.0",
  "description": "Unleash integration for GitHub workflows",
  "main": "./dist/index.js",
  "repository": "https://github.com/Unleash/unleash-action.git",
  "license": "Apache-2.0",
  "type": "module",
