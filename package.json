  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@biomejs/biome": "2.6.9",
    "@jest/globals": "^30.5.2",
    "@types/node": "26.6.10",
    "@vercel/ncc": "^0.45.0",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  },
  "resolutions": {
    "minimatch": "^11.0.1"
  }
